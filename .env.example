# Comma-separated browser origins allowed to call the API.
CODEQUEST_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Supabase project configuration. The publishable key is safe for browser use
# only when database Row Level Security is enabled. Never use a service-role key here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Required only for the backend's server-side global leaderboard RPCs.
SUPABASE_SERVICE_ROLE_KEY=

# AI Code Mentor credentials stay on the backend; never copy them to frontend/config.js.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional isolated Judge0-compatible runner. Java/C++ missions need both values.
# Keep the runner key server-side; never put it in frontend/config.js.
RUNNER_API_URL=
RUNNER_API_KEY=
RUNNER_PYTHON_LANGUAGE_ID=71
RUNNER_JAVA_LANGUAGE_ID=62
RUNNER_CPP_LANGUAGE_ID=54
